{
  "name": "claude-code-archive-plugin",
  "version": "0.1.2",
  "private": true,
  "description": "Archive every Claude Code session to Google Drive; keep the local disk as a cache of recent sessions.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --no-warnings --test --test-reporter=spec \"test/**/*.test.ts\"",
    "test:coverage": "node --experimental-strip-types --no-warnings --test --experimental-test-coverage \"test/**/*.test.ts\"",
    "build": "node --experimental-strip-types --no-warnings scripts/build.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "undici": "7.29.0"
  }
}
